# Sao chép file này thành .env.local rồi điền giá trị.

# ---- Tên miền khi deploy (dùng cho SEO: sitemap, ảnh chia sẻ) ----
NEXT_PUBLIC_SITE_URL=https://ten-mien-cua-ban.vn

# ---- Đăng nhập trang quản trị ----
ADMIN_PASSWORD=doi-mat-khau-nay
SESSION_SECRET=chuoi-ngau-nhien-it-nhat-32-ky-tu

# ---- Database Turso (bỏ trống = dùng file data/app.db trên máy) ----
TURSO_DATABASE_URL=libsql://ten-database-ten-ban.turso.io
TURSO_AUTH_TOKEN=

# ---- Lưu ảnh Cloudflare R2 (bỏ trống = lưu vào data/uploads trên máy) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Link công khai của bucket, ví dụ https://pub-xxxx.r2.dev (không có dấu / ở cuối)
R2_PUBLIC_URL=
