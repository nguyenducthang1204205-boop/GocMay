{
  "name": "website_anh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:cloud": "node --env-file=.env.local scripts/migrate-to-cloud.mjs",
    "cf:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cloudflare.mjs setup",
    "cf:db:push": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cloudflare.mjs db:push",
    "cf:preview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cloudflare.mjs preview",
    "cf:deploy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cloudflare.mjs deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cloudflare.mjs db:migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@libsql/client": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "aws4fetch": "^1.0.20",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.168.0"
  }
}
